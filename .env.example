# ── MariaDB ──────────────────────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=rag_luciana
DB_USER=rag
DB_PASSWORD=change-me

# ── Qdrant ───────────────────────────────────────────────
QDRANT_HOST=127.0.0.1
QDRANT_PORT=6333

# ── Ollama (embeddings) ─────────────────────────────────
OLLAMA_HOST=127.0.0.1
OLLAMA_PORT=11435
OLLAMA_EMBED_MODEL=nomic-embed-text
HYBRID_ENABLED=true
SPARSE_ENABLED=true
SPARSE_MODEL=Qdrant/bm25
SPARSE_TOP_TERMS_LOG=12
SPARSE_MIN_WEIGHT_LOG=0.0
PREWARM_SPARSE_ON_STARTUP=true
RERANKER_ENABLED=true
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RRF_K=60
RRF_K_HYBRID=60
RERANKER_CANDIDATE_MULTIPLIER=3
RERANKER_DEVICE=
RERANKER_BATCH_SIZE=16
RERANKER_MAX_LENGTH=512
RERANKER_TRUST_REMOTE_CODE=false
PREWARM_EMBEDDINGS_ON_STARTUP=true
PREWARM_RERANKER_ON_STARTUP=true

# ── API ──────────────────────────────────────────────────
API_PORT=8000
ADMIN_KEY=super-secret-admin-key
